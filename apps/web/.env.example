# Адрес NestJS API для серверсайд-фечей и рерайта /uploads (в проде — внутренний адрес контейнера/сервиса)
API_URL=http://localhost:3002

# Ключ Яндекс.СмартКапчи (client-side)
NEXT_PUBLIC_SMARTCAPTCHA_SITEKEY=ysc1_xxx

# Ключ Яндекс.Карт для виджета на /contacts (необязателен: без него фолбэк-iframe)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Канонический origin сайта: OG-теги, canonical, sitemap (в проде — реальный домен)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
