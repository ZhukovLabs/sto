{
  "name": "@sto/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "postinstall": "prisma generate",
    "gen:openapi": "nest build && node dist/src/gen-openapi.js",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "create-admin": "nest build && node dist/src/scripts/create-admin.js",
    "login:telegram": "nest build && node dist/src/scripts/login-telegram.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@sto/types": "workspace:*",
    "big-integer": "^1.6.52",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "teleproto": "^1.229.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "dotenv": "^18.0.5",
    "prisma": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
