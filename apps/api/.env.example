DATABASE_URL="postgresql://sto:sto@localhost:5432/sto"
PORT=3002
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_SECRET="строка не короче 32 символов: openssl rand -hex 32"
ADMIN_EMAIL="email первого администратора для pnpm create-admin"
ADMIN_PASSWORD="пароль не короче 8 символов"

# Дневной лимит платных уведомлений (Viber + SMS). Telegram не считается.
PAID_CHANNELS_DAILY_LIMIT=50
SMARTCAPTCHA_SERVER_KEY=ysc2_xxx

# Origin веба и секрет для сброса его ISR-кэша из API (необязательно, но в проде нужно)
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=

# Хранилище обложек/медиа (SeaweedFS/S3-совместимое). Пусто — локальный диск ./uploads.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=sto-media

# ИИ-автогенерация новостей (Z.ai). Пусто — автопилот недоступен.
LLM_API_KEY=
LLM_MODEL=glm-4.5-flash

# Ключ Pixabay для подбора стоковых обложек (необязателен)
PIXABAY_API_KEY=
