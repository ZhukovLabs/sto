{
  "name": "sto",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @sto/web dev",
    "dev:admin": "pnpm --filter @sto/admin dev",
    "dev:api": "pnpm --filter @sto/api start:dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "gen:types": "pnpm --filter @sto/api gen:openapi && pnpm --filter @sto/types gen",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "docker:full": "docker compose --profile full up -d --build",
    "docker:down": "docker compose --profile full down",
    "db:migrate": "pnpm --filter @sto/api db:migrate",
    "db:studio": "pnpm --filter @sto/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript-eslint": "^8.71.0"
  }
}
