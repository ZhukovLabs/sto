    "/requests": {
      "post": {
        "operationId": "RequestsController_create",
        "parameters": [
          {
            "name": "idempotency-key",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-captcha-token",
            "required": false,
            "in": "header",
            "description": "Токен Яндекс SmartCaptcha — нужен при повторных отправках",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Ключ идемпотентности (8–64 символа)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRequestBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRequestResponse"
                }
              }
            }
          },
          "428": {
            "description": "Требуется прохождение капчи"
          },
          "429": {
            "description": "Слишком много заявок с одного адреса"
          }
        },
        "summary": "Создать заявку «Перезвоните мне» (публичный, идемпотентен с Idempotency-Key)",
        "tags": [
          "requests"
        ]
      },
      "get": {
        "operationId": "RequestsController_list",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "new",
                "called",
                "taken",
                "cancelled"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Список заявок (по убыванию даты)",
        "tags": [
          "requests"
        ]
      }
    },
