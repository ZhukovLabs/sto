  "info": {
    "title": "STO API",
    "description": "API автосервиса: публичный сайт и админка",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:3002",
      "description": "локальная разработка"
    }
  ],
  "components": {
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok",
            "description": "Статус сервиса"
          },
          "uptime": {
            "type": "number",
            "example": 123.45,
            "description": "Uptime процесса в секундах"
          }
        },
        "required": [
          "status",
          "uptime"
        ]
      },
      "NotificationSettingsBody": {
        "type": "object",
        "properties": {
          "channelOrder": {
            "example": [
              "telegram",
              "viber",
              "sms"
            ],
            "description": "Каналы подтверждений в порядке попытки доставки",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "channelOrder"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@promaks.by"
          },
          "password": {
            "type": "string",
            "example": "пароль"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Токен сессии для заголовка Authorization: Bearer"
          },
          "expiresAt": {
            "type": "number",
            "description": "Токен истекает в Unix-времени, секунды"
          }
        },
        "required": [
          "token",
          "expiresAt"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "uuid"
          },
          "email": {
            "type": "string",
            "example": "admin@promaks.by"
          },
          "name": {
            "type": "string",
            "example": "Максим"
          },
          "role": {
            "type": "string",
            "example": "admin"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role"
        ]
      },
      "RefreshResponseDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Новый токен сессии"
          },
          "expiresAt": {
            "type": "number",
            "description": "Новый срок истечения, Unix-время в секундах"
          }
        },
        "required": [
          "token",
          "expiresAt"
        ]
      },
      "CreateRequestBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Иван",
            "minLength": 2,
            "maxLength": 80
          },
          "phone": {
            "type": "string",
            "example": "+375 29 123-45-67"
          },
          "comment": {
            "type": "string",
            "example": "Машину тянет вправо, звоните после 18:00",
            "maxLength": 500
          },
          "company": {
            "type": "string",
            "description": "Honeypot-поле: заполнено только ботами"
          }
        },
        "required": [
          "name",
          "phone"
        ]
      },
      "CreateRequestResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "duplicate": {
            "type": "boolean",
            "example": false,
            "description": "true — заявка уже существовала (повторный Idempotency-Key)"
          }
        },
        "required": [
          "id",
          "duplicate"
        ]
      },
      "UpdateRequestStatusBody": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "new",
              "called",
              "taken",
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "DateView": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "example": "2026-11-12"
          },
          "disabled": {
            "type": "boolean",
            "example": false,
            "description": "true — свободных слотов нет"
          }
        },
        "required": [
          "date",
          "disabled"
        ]
      },
      "SlotView": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "example": "14:00"
          },
          "available": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "time",
          "available"
        ]
      },
      "CreateBookingBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Иван",
            "minLength": 2,
            "maxLength": 80
          },
          "phone": {
            "type": "string",
            "example": "+375 29 123-45-67"
          },
          "company": {
            "type": "string",
            "description": "Honeypot-поле: заполнено только ботами"
          },
          "car": {
            "type": "string",
            "example": "Toyota Corolla 2015"
          },
          "services": {
            "example": [
              "Диагностика подвески",
              "Замена масла"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "comment": {
            "type": "string",
            "example": "Стучит спереди на кочках"
          },
          "date": {
            "type": "string",
            "example": "2026-11-12",
            "description": "YYYY-MM-DD"
          },
          "time": {
            "type": "string",
            "example": "14:00",
            "description": "HH:MM"
          }
        },
        "required": [
          "name",
          "phone",
          "date",
          "time"
        ]
      },
      "CreateBookingResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "duplicate": {
            "type": "boolean",
            "example": false,
            "description": "true — запись уже существовала (повторный Idempotency-Key)"
          }
        },
        "required": [
          "id",
          "duplicate"
        ]
      },
      "DayOverviewSlot": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "example": "14:00"
          },
          "status": {
            "type": "string",
            "enum": [
              "free",
              "booked",
              "blocked"
            ]
          },
          "past": {
            "type": "boolean",
            "example": false,
            "description": "true — слот уже прошёл"
          },
          "bookingNames": {
            "example": [
              "Иван"
            ],
            "description": "Имена клиентов с активной записью на слот",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "time",
          "status",
          "past",
          "bookingNames"
        ]
      },
      "DayOverviewResponse": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "example": "2026-11-12"
          },
          "enabled": {
            "type": "boolean",
            "example": true,
            "description": "false — день закрыт (выходной)"
          },
          "from": {
            "type": "string",
            "example": "09:00"
          },
          "to": {
            "type": "string",
            "example": "20:00"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DayOverviewSlot"
            }
          }
        },
        "required": [
          "date",
          "enabled",
          "slots"
        ]
      },
      "UpdateBookingStatusBody": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "booked",
              "confirmed",
              "taken",
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateMasterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Имя мастера",
            "example": "Максим"
          },
          "telegramChatId": {
            "type": "string",
            "description": "chat_id из /start у бота",
            "example": "1160368886"
          }
        },
        "required": [
          "name",
          "telegramChatId"
        ]
      },
      "UpdateMasterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Имя мастера",
            "example": "Максим"
          },
          "isActive": {
            "type": "boolean",
            "description": "Получать заявки",
            "example": true
          }
        }
      },
      "ServiceViewDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "zamena-masla"
          },
          "groupId": {
            "type": "string",
            "example": "shinomontazh"
          },
          "title": {
            "type": "string",
            "example": "Замена масла"
          },
          "description": {
            "type": "string",
            "example": "Синтетика"
          },
          "priceFrom": {
            "type": "number",
            "example": 60
          },
          "priceTo": {
            "type": "object",
            "nullable": true,
            "example": 120
          },
          "unit": {
            "type": "string",
            "nullable": true,
            "enum": [
              "wheel",
              "pcs",
              "season"
            ]
          },
          "photo": {
            "type": "object",
            "nullable": true,
            "example": "/uploads/oil.webp"
          },
          "position": {
            "type": "number",
            "example": 0
          },
          "isActive": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "id",
          "groupId",
          "title",
          "description",
          "priceFrom",
          "priceTo",
          "unit",
          "photo",
          "position",
          "isActive"
        ]
      },
      "ServiceGroupViewDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "shinomontazh"
          },
          "title": {
            "type": "string",
            "example": "Шиномонтаж"
          },
          "icon": {
            "type": "string",
            "nullable": true,
            "enum": [
              "scan",
              "wrench",
              "disc",
              "cog",
              "gauge",
              "circle",
              "snowflake"
            ]
          },
          "photo": {
            "type": "object",
            "nullable": true,
            "example": "/uploads/tyres.webp"
          },
          "position": {
            "type": "number",
            "example": 0
          },
          "isActive": {
            "type": "boolean",
            "example": true
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceViewDto"
            }
          }
        },
        "required": [
          "id",
          "title",
          "icon",
          "photo",
          "position",
          "isActive",
          "services"
        ]
      },
      "ShowcaseSlotViewDto": {
        "type": "object",
        "properties": {
          "serviceId": {
            "type": "string",
            "example": "zamena-masla"
          },
          "position": {
            "type": "number",
            "example": 0
          }
        },
        "required": [
          "serviceId",
          "position"
        ]
      },
      "CatalogResponseDto": {
        "type": "object",
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceGroupViewDto"
            }
          },
          "showcase": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShowcaseSlotViewDto"
            }
          }
        },
        "required": [
          "groups",
          "showcase"
        ]
      },
