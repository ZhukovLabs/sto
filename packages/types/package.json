{
  "name": "@sto/types",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "gen": "openapi-typescript ./openapi.json -o ./src/generated/schema.ts",
    "build": "pnpm run gen && tsc -p tsconfig.json",
    "typecheck": "pnpm run gen && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "catalog:",
    "typescript": "catalog:"
  }
}
